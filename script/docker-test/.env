# =============================================
# 后端 JVM 参数
# =============================================
JAVA_OPTS=-Xms512m -Xmx1024m -Dspring.profiles.active=prod -Duser.timezone=Asia/Shanghai -Djava.security.egd=file:/dev/./urandom -XX:+UseG1GC

# =============================================
